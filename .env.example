# Copy to .env and fill in. Never commit .env.
# HCX (HyperCLOVA X, backend: hcx). CLOVA Studio API key (starts with nv-). URL and model are in configs/model.yaml.
HCX_API_KEY=
# Gemini (backend: gemini)
GEMINI_API_KEY=
# Pre-test model (backend: openai_compat). Leave empty for local servers like Ollama.
PRETEST_API_KEY=
# KOSIS OpenAPI
KOSIS_API_KEY=
